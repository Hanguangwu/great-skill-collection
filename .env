# 站点链接统一配置。改这里，不要在组件里硬编码。
# 复制为 .env.local 可覆盖本地值（.env.local 不入库）。

# GitHub 仓库根地址（无末尾斜杠）。owner / siteUrl / 各页面链接都由它推导。
VITE_REPO_URL=https://github.com/Hanguangwu/great-skill-collection

# 线上站点地址。留空则由 VITE_REPO_URL 推导为 https://<owner>.github.io/<repo>
# VITE_SITE_URL=https://hanguangwu.github.io/great-skill-collection

# 部署子路径。GitHub Pages 项目页必须带仓库名；改成仓库根或自定义域名时设为 / 。
# vite.config.ts 的 base 和 BrowserRouter 的 basename 都读这个值。
VITE_BASE_PATH=/great-skill-collection/

# 展示用的作者名。留空则取 VITE_REPO_URL 里的 owner。
VITE_OWNER=Qingyang
